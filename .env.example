# Copy to .env (or export in your shell). All optional — sane defaults.
# Port for the web app (binds 127.0.0.1 only)
PORT=3000
# OpenAI-compatible LLM endpoint (Ollama default; LM Studio uses http://127.0.0.1:1234/v1)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:8b
# Record/replay mode for offline dev & tests: set to "fixtures" to replay ./fixtures
# ANILIST_FIXTURES=fixtures
